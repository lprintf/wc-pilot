# =====================================================================
# AI 客服展示助手 - 环境变量示例
# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库。
# =====================================================================

# ---- 企业微信（必填）------------------------------------------------
# 企业微信企业 ID（CorpID）
CorpID=ww__________________

# 企业微信自建应用 AgentID，用于获取 access_token
APP_AGENT_ID=1000002

# 企业微信自建应用 Secret
APP_AGENT_SECRET=__________________

# ---- 微信客服回调（必填）-------------------------------------------
# 回调 Token，与企微后台「接收消息」配置一致
WECHAT_KF_CALLBACK_TOKEN=change_me

# 回调 EncodingAESKey，必须为 43 个字符
WECHAT_KF_ENCODING_AES_KEY=change_me_43_chars_________________________

# 客服账号 open_kfid（可选）。留空则接受本企业回调中的任意 open_kfid
WECHAT_KF_OPEN_KFID=

# ---- 公网地址（必填）------------------------------------------------
# 可被企业微信访问的 HTTPS 根地址；回调地址为 ${PUBLIC_BASE_URL}/wecom/kf/callback
PUBLIC_BASE_URL=https://your-domain.example.com

# 客服会话入口链接（可选，用于用户中心返回提示）
CUSTOM_SERVICE_URL=https://work.weixin.qq.com/kfid/kf________

# ---- LLM（必填）-----------------------------------------------------
# OpenAI 兼容 API 地址，应包含版本路径，如 /v1
LLM_BASE_URL=https://your-llm-provider.example.com/v1

# LLM API Key
LLM_API_KEY=sk-__________________

# 模型名称
LLM_MODEL=your-model-name

# ---- 数据与后台（可选）---------------------------------------------
# SQLite 数据库路径；Docker 中默认写入持久化卷 /app/data
DATABASE_PATH=data/wechat_bot.db

# Admin 后台 Basic Auth 凭据；两者都配置时启用 /admin/
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# ---- 企业微信群机器人（可选，非客服 API）--------------------------
# 仅用于群内通知，不属于微信客服 API
BOT_ID=
BOT_SECRET=
# ---- 镜像源（构建参数，可选）----------------------------------------
# official（默认）/ tencent / aliyun / china / custom
MIRROR=official

# MIRROR=china 时使用
CHINA_PYPI_URL=
CHINA_NPM_URL=

# MIRROR=custom 时使用
CUSTOM_PYPI_URL=
CUSTOM_NPM_URL=
